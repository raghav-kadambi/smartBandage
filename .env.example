# Copy this file to .env and fill in your values.
# The app auto-loads .env on startup (see app.py) -- no extra package needed.

SECRET_KEY=change-this-to-any-random-string

# Chat assistant (optional -- the app runs without it)
GROQ_API_KEY=gsk-your-key-here
GROQ_MODEL=openai/gpt-oss-120b

# Server binding. 0.0.0.0 lets an ESP32 on the same Wi-Fi reach the app;
# use 127.0.0.1 for slider-only demos. FLASK_DEBUG=1 enables the reloader/debugger.
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=0
